{
  "$comment": "Free My TV design tokens (proposal). One source for Android (generated Tokens.java) and web/ (generated tokens.css with literal values, no CSS variables: webOS 3/4 lack them). Sizes are px on the 1920x1080 stage; Android multiplies by k.",
  "color": {
    "light": {
      "bg.top": "#F5F5F7", "bg.bottom": "#E2E2E7", "veil": "rgba(245,245,247,0.74)",
      "ink": "#1D1D1F", "ink.secondary": "#6E6E73", "ink.tertiary": "#8E8E93",
      "card.empty": "#DADADF", "numeral": "#D2D2D7", "numeral.focus": "#1D1D1F",
      "glass.top": "rgba(255,255,255,0.86)", "glass.bottom": "rgba(255,255,255,0.66)",
      "focus.fill": "#FFFFFF", "focus.ink": "#1D1D1F", "focus.ring": "#FFFFFF", "focus.ringEdge": "rgba(0,0,0,0.16)"
    },
    "dark": {
      "bg.top": "#1C1C1E", "bg.bottom": "#0B0B0D", "veil": "rgba(11,11,13,0.78)",
      "ink": "#F5F5F7", "ink.secondary": "rgba(245,245,247,0.68)", "ink.tertiary": "rgba(245,245,247,0.50)",
      "card.empty": "#2C2C2E", "numeral": "rgba(245,245,247,0.16)", "numeral.focus": "#F5F5F7",
      "glass.top": "rgba(38,38,42,0.78)", "glass.bottom": "rgba(17,17,19,0.64)",
      "focus.fill": "#FFFFFF", "focus.ink": "#1D1D1F", "focus.ring": "#FFFFFF", "focus.ringEdge": "rgba(0,0,0,0.5)"
    },
    "accent": { "on": "#3FD69B", "warn": "#FFC266", "up": "#248A3D", "down": "#D70015" },
    "scrim.pop": "rgba(0,0,0,0.60)", "scrim.popNoBlur": "rgba(0,0,0,0.74)"
  },
  "type": {
    "family": "Inter (InterVariable.ttf), tabular numbers for clocks and prices",
    "display":  {"size": 176, "weight": 200, "use": "empty-state clock"},
    "title":    {"size": 76,  "weight": 600, "use": "For You"},
    "numeral":  {"size": 300, "weight": 800, "use": "Top 10 rank"},
    "headline": {"size": 44,  "weight": 600, "use": "pop-out title, sheet titles"},
    "rowTitle": {"size": 32,  "weight": 600, "use": "row names"},
    "body":     {"size": 30,  "weight": 500, "use": "tabs, settings rows, card names"},
    "caption":  {"size": 28,  "weight": 500, "use": "meta, reasons, hints - the floor"}
  },
  "space": {"margin": 80, "contentRight": 1840, "gap.card": 32, "gap.row": 48, "unit": 8},
  "radius": {"card": 18, "tile": 22, "row": 20, "pill": 999, "panel": 30, "sheet": 40, "platter": 62},
  "card": {"rowH": 360, "wideW": 640, "narrowW": 240, "heroH": 442, "heroWideW": 1040, "heroNarrowW": 320},
  "focus": {"scale.card": 1.05, "scale.tile": 1.2, "scale.key": 1.1, "lift": 6, "ring": 4, "ringOffset": 0, "shadow": "0 24px 46px rgba(0,0,0,0.34)"},
  "motion": {
    "focus":  {"ms": 220, "ease": "cubic-bezier(0.2,0.9,0.3,1.15)"},
    "scroll": {"ms": 320, "ease": "cubic-bezier(0.2,0.9,0.3,1)", "spring": [0.32, 0.78]},
    "pop":    {"ms": 520, "ease": "cubic-bezier(0.32,0.72,0,1)"},
    "fade":   {"ms": 300},
    "rest.trailer": 1500,
    "reducedMotion": "lite class / Low-memory mode: no shadows, no transitions, widths snap"
  }
}
